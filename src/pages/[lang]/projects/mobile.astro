---
import ProjectsFilter from "@/components/ProjectsFilter.astro";
import Layout from "@/layouts/Layout.astro";
import { t as i18n } from "@/lib/i18n";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const { lang } = Astro.params;
const validLang = lang === "en" || lang === "es" ? lang : "en";

const T = i18n(validLang);
export const prerender = true;
---

<Layout title={T.projectsPage.title} description={T.projectsPage.description} lang={validLang}>
  <ProjectsFilter validLang={validLang} category="mobile" />
</Layout>
