---
import Analytics from '@vercel/analytics/astro'
import { ViewTransitions } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { t as i18n } from "@/lib/i18n";

interface Props {
  title: string;
  description: string;
  lang?: "en" | "es";
}

const {
  title,
  description,
  lang = "en",
} = Astro.props;

const T = i18n(lang);
const altLang = lang === "en" ? "es" : "en";
const countryFlag = lang === "en" ? "/icons/esp.svg" : "/icons/gbr.svg";
const currentPath = Astro.url.pathname;
const altPath = currentPath.replace(`/${lang}`, `/${altLang}`);
export const prerender = true;
---

<!doctype html>
<html lang={lang}>
  <head>
    <title>{title}</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <!-- OG -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:site_name"
      content="Sergio Domínguez Pérez - Full-Stack Developer Portfolio"
    />
    <meta name="keywords" content="Sergio Domínguez Pérez, Full-Stack Developer, Portfolio, programador, programador españa, nodejs, react, angular, php, symfony, wordpress, tailwind, bootstrap, " />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(currentPath, Astro.site).href} />
    <meta property="og:image" content={new URL("/screenshot.jpg", Astro.site).href} />
    <meta
      property="og:image:alt"
      content="Sergio Domínguez Pérez - Full-Stack Developer Portfolio"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpg" />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/screenshot.jpg", Astro.site).href} />
    <meta name="twitter:creator" content="@sergiolkg" />
    <meta name="twitter:site" content="@sergiolkg" />
    <meta name="twitter:site:id" content="sergiolkg" />
    <meta name="twitter:creator:id" content="sergiolkg" />
    <meta
      name="twitter:image:alt"
      content="Sergio Domínguez Pérez - Full-Stack Developer Portfolio"
    />
    <!-- scripts -->
    <ViewTransitions />
    <!-- links -->
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon-light.svg"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon-dark.svg"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="alternate"
      hreflang="en"
      href={new URL(`/en${currentPath.replace(/^\/(en|es)/, "")}`, Astro.site).href}
    />
    <link
      rel="alternate"
      hreflang="es"
      href={new URL(`/es${currentPath.replace(/^\/(en|es)/, "")}`, Astro.site).href}
    />
    <link
      rel="canonical"
      href={new URL(currentPath, Astro.site).href}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: "Sergio Domínguez Pérez",
      url: new URL(currentPath, Astro.site).href,
      image: new URL("/screenshot.jpg", Astro.site).href,
      jobTitle: "Full-Stack Developer",
      sameAs: [
        "https://github.com/SergioLKG",
        "https://www.linkedin.com/in/sergiodominguezperez/"
      ],
      knowsAbout: ["Web Development", "Mobile Development", "Full-Stack Development", "React", "Node.js", "TypeScript", "Symfony", "WordPress"],
      address: {
        "@type": "PostalAddress",
        addressLocality: "Madrid",
        addressCountry: "ES"
      }
    })} />
  </head>
  <body
    class="bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 min-h-screen flex flex-col"
  >
    <Header
      lang={lang}
      translations={T.nav}
      altLang={altLang}
      altPath={altPath}
      countryFlag={countryFlag}
    />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      const isDarkMode =
        localStorage.getItem("darkMode") === "true" ||
        (localStorage.getItem("darkMode") === null &&
          window.matchMedia("(prefers-color-scheme: dark)").matches);

      if (isDarkMode) {
        document.documentElement.classList.add("dark");
      }
    </script>
    <Analytics />
  </body>
</html>
